{
  "artifact": "apparatus check, not a claim result",
  "client": {
    "confluent_kafka": "2.11.1",
    "librdkafka": "2.11.1"
  },
  "configurations": {
    "baseline": {
      "clients": {
        "consumer": {
          "auto.commit.interval.ms": 5000,
          "auto.offset.reset": "earliest",
          "bootstrap.servers": "127.0.0.1:29092",
          "enable.auto.commit": true,
          "enable.auto.offset.store": true,
          "enable.partition.eof": true,
          "group.id": "proofbench.r05.baseline",
          "isolation.level": "read_uncommitted",
          "queued.min.messages": 1000,
          "session.timeout.ms": 45000
        },
        "ingest_producer": {
          "batch.size": 16384,
          "bootstrap.servers": "127.0.0.1:29092",
          "enable.idempotence": false,
          "linger.ms": 5,
          "message.timeout.ms": 15000
        },
        "sink_producer": {
          "batch.size": 16384,
          "bootstrap.servers": "127.0.0.1:29092",
          "enable.idempotence": false,
          "linger.ms": 5,
          "message.timeout.ms": 15000
        },
        "verifier": {
          "auto.offset.reset": "earliest",
          "bootstrap.servers": "127.0.0.1:29092",
          "enable.auto.commit": false,
          "enable.auto.offset.store": true,
          "enable.partition.eof": true,
          "group.id": "proofbench.r05.baseline.verify",
          "isolation.level": "read_committed",
          "queued.min.messages": 1000,
          "session.timeout.ms": 45000
        }
      },
      "name": "baseline",
      "offset_commit": "auto_before_processing",
      "topics": {
        "input": "proofbench.r05.baseline.input",
        "sink_a": "proofbench.r05.baseline.sink_a",
        "sink_b": "proofbench.r05.baseline.sink_b"
      },
      "transaction_boundary": null
    },
    "good": {
      "clients": {
        "consumer": {
          "auto.offset.reset": "earliest",
          "bootstrap.servers": "127.0.0.1:29092",
          "enable.auto.commit": false,
          "enable.auto.offset.store": true,
          "enable.partition.eof": true,
          "group.id": "proofbench.r05.good",
          "isolation.level": "read_committed",
          "queued.min.messages": 1000,
          "session.timeout.ms": 45000
        },
        "ingest_producer": {
          "batch.size": 16384,
          "bootstrap.servers": "127.0.0.1:29092",
          "enable.idempotence": true,
          "linger.ms": 5,
          "message.timeout.ms": 15000,
          "transactional.id": "proofbench.r05.good.ingest"
        },
        "sink_producer": {
          "batch.size": 16384,
          "bootstrap.servers": "127.0.0.1:29092",
          "enable.idempotence": true,
          "linger.ms": 5,
          "message.timeout.ms": 15000,
          "transactional.id": "proofbench.r05.good.sink"
        },
        "verifier": {
          "auto.offset.reset": "earliest",
          "bootstrap.servers": "127.0.0.1:29092",
          "enable.auto.commit": false,
          "enable.auto.offset.store": true,
          "enable.partition.eof": true,
          "group.id": "proofbench.r05.good.verify",
          "isolation.level": "read_committed",
          "queued.min.messages": 1000,
          "session.timeout.ms": 45000
        }
      },
      "name": "good",
      "offset_commit": "inside_transaction",
      "topics": {
        "input": "proofbench.r05.good.input",
        "sink_a": "proofbench.r05.good.sink_a",
        "sink_b": "proofbench.r05.good.sink_b"
      },
      "transaction_boundary": "per_saga"
    }
  },
  "executed": "baseline"
}
