# Example environment for ProofBench. Copy to .env and adjust locally.
# This file is the ONLY place example connection values appear (INV-1).
# Everything below is read by src/proofbench/config.py.

# ---------------------------------------------------------------------------
# Connection details and paths
# ---------------------------------------------------------------------------

# The broker the harness dials. Unset by default, and everything that needs it
# says so rather than assuming a default: the integration test skips with a named
# reason when it is absent, which is what keeps CI offline and booting nothing.
# `make broker-up` brings up the single-node KRaft broker from docker-compose.yml
# and prints the value to use here.
# PB_BROKER_BOOTSTRAP_SERVERS=host:port

# The host port docker-compose.yml publishes the broker on. Read by compose, not
# by Settings. If you change it, change the port in
# PB_BROKER_BOOTSTRAP_SERVERS above to match: compose uses this value for both
# the published port and the advertised HOST listener, so the two cannot
# disagree with each other, but nothing forces them to agree with the address
# the harness dials.
PB_BROKER_HOST_PORT=29092

# Where a harness run writes its ledgers and evidence (git-ignored).
PB_RUN_OUTPUT_DIR=runs

# The committed frozen schedule, relative to the repository root.
PB_SCHEDULE_PATH=docs/run_schedule.json

# Log verbosity for the structured logger.
PB_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Frozen experiment constants (ADR-0002)
#
# These are the values that were fixed before the first broker boot and before
# any measurement. They are emitted into docs/run_schedule.json, which a
# byte-equality test pins, so overriding any of them here makes `make test` go
# red. That is deliberate: it is what stops the numbers driving a claim's
# outcome from moving after the outcome is known. Overriding them is for
# experimenting locally, never for producing a reported result.
# ---------------------------------------------------------------------------

# The master seed the schedule expands from: the CLAIMS.md pre-registration date.
PB_MASTER_SEED=20260728

# The saga steps, in order (JSON). CLAIMS.md names exactly these three.
PB_SAGA_STEP_NAMES=["create_ticket", "charge_card", "send_confirmation"]

# Sagas per run (N). 200 sagas of 3 steps is 600 side effects per run.
PB_SAGAS_PER_RUN=200

# The number of seeded kill runs. CLAIMS.md fixes this at 20.
PB_KILL_RUNS=20

# The fault menu, verbatim from CLAIMS.md (JSON).
PB_FAULT_MENU=["producer_sigkill_mid_send", "consumer_sigkill_between_sinks", "broker_stop_start"]

# The fault_type recorded for the no-fault control run, and the run_id it holds.
PB_NO_FAULT_LABEL=none
PB_CONTROL_RUN_ID=0

# The band of the saga stream a fault point may land in, as fractions of N (JSON).
PB_FAULT_SAGA_BAND=[0.2, 0.8]

# Where one transaction begins and ends in the good configuration.
PB_TRANSACTION_BOUNDARY=per_saga

# ---------------------------------------------------------------------------
# Frozen client tuning, shared by both configurations (ADR-0002).
# Spelled for librdkafka (confluent-kafka), not for the Java client.
# ---------------------------------------------------------------------------

# librdkafka linger.ms (alias queue.buffering.max.ms).
PB_PRODUCER_LINGER_MS=5

# librdkafka batch.size, bytes.
PB_PRODUCER_BATCH_SIZE_BYTES=16384

# Records handed to the application per poll, passed as num_messages to
# Consumer.consume(). This is the librdkafka-side equivalent of the Java
# consumer's max.poll.records, which librdkafka does not have.
PB_CONSUMER_MAX_BATCH_RECORDS=100

# librdkafka queued.min.messages, the client-side prefetch depth.
PB_CONSUMER_QUEUED_MIN_MESSAGES=1000

# ---------------------------------------------------------------------------
# Frozen tuning for the known-bad baseline only (ADR-0002)
# ---------------------------------------------------------------------------

# librdkafka auto.commit.interval.ms. Applies to the baseline configuration
# only; the good configuration commits offsets inside the transaction.
PB_BASELINE_AUTO_COMMIT_INTERVAL_MS=5000
